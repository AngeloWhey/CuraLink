Options Temp=25 ResourceUsage=yes UseNutmegFormat=no EnableOptim=no
IDX=0
PinR=25
LinkK=0.0662
ILOADmA=24
QCAP=500
LEADnH=1
RWIND=1
CUF=1
CTS=58.2+(1.1)*max(0,min(1,min(IDX-27+1,53+1-IDX)))+(2.2)*max(0,min(1,min(IDX-54+1,80+1-IDX)))
CTH=330+(45)*max(0,min(1,min(IDX-9+1,17+1-IDX)))+(90)*max(0,min(1,min(IDX-18+1,26+1-IDX)))+(45)*max(0,min(1,min(IDX-36+1,44+1-IDX)))+(90)*max(0,min(1,min(IDX-45+1,53+1-IDX)))+(45)*max(0,min(1,min(IDX-63+1,71+1-IDX)))+(90)*max(0,min(1,min(IDX-72+1,80+1-IDX)))
CRS=1000+(-180)*max(0,min(1,min(IDX-0+1,2+1-IDX)))+(-90)*max(0,min(1,min(IDX-3+1,5+1-IDX)))+(-180)*max(0,min(1,min(IDX-9+1,11+1-IDX)))+(-90)*max(0,min(1,min(IDX-12+1,14+1-IDX)))+(-180)*max(0,min(1,min(IDX-18+1,20+1-IDX)))+(-90)*max(0,min(1,min(IDX-21+1,23+1-IDX)))+(-180)*max(0,min(1,min(IDX-27+1,29+1-IDX)))+(-90)*max(0,min(1,min(IDX-30+1,32+1-IDX)))+(-180)*max(0,min(1,min(IDX-36+1,38+1-IDX)))+(-90)*max(0,min(1,min(IDX-39+1,41+1-IDX)))+(-180)*max(0,min(1,min(IDX-45+1,47+1-IDX)))+(-90)*max(0,min(1,min(IDX-48+1,50+1-IDX)))+(-180)*max(0,min(1,min(IDX-54+1,56+1-IDX)))+(-90)*max(0,min(1,min(IDX-57+1,59+1-IDX)))+(-180)*max(0,min(1,min(IDX-63+1,65+1-IDX)))+(-90)*max(0,min(1,min(IDX-66+1,68+1-IDX)))+(-180)*max(0,min(1,min(IDX-72+1,74+1-IDX)))+(-90)*max(0,min(1,min(IDX-75+1,77+1-IDX)))
CRH=680+(70)*max(0,1-abs(IDX-1))+(140)*max(0,1-abs(IDX-2))+(70)*max(0,1-abs(IDX-4))+(140)*max(0,1-abs(IDX-5))+(70)*max(0,1-abs(IDX-7))+(140)*max(0,1-abs(IDX-8))+(70)*max(0,1-abs(IDX-10))+(140)*max(0,1-abs(IDX-11))+(70)*max(0,1-abs(IDX-13))+(140)*max(0,1-abs(IDX-14))+(70)*max(0,1-abs(IDX-16))+(140)*max(0,1-abs(IDX-17))+(70)*max(0,1-abs(IDX-19))+(140)*max(0,1-abs(IDX-20))+(70)*max(0,1-abs(IDX-22))+(140)*max(0,1-abs(IDX-23))+(70)*max(0,1-abs(IDX-25))+(140)*max(0,1-abs(IDX-26))+(70)*max(0,1-abs(IDX-28))+(140)*max(0,1-abs(IDX-29))+(70)*max(0,1-abs(IDX-31))+(140)*max(0,1-abs(IDX-32))+(70)*max(0,1-abs(IDX-34))+(140)*max(0,1-abs(IDX-35))+(70)*max(0,1-abs(IDX-37))+(140)*max(0,1-abs(IDX-38))+(70)*max(0,1-abs(IDX-40))+(140)*max(0,1-abs(IDX-41))+(70)*max(0,1-abs(IDX-43))+(140)*max(0,1-abs(IDX-44))+(70)*max(0,1-abs(IDX-46))+(140)*max(0,1-abs(IDX-47))+(70)*max(0,1-abs(IDX-49))+(140)*max(0,1-abs(IDX-50))+(70)*max(0,1-abs(IDX-52))+(140)*max(0,1-abs(IDX-53))+(70)*max(0,1-abs(IDX-55))+(140)*max(0,1-abs(IDX-56))+(70)*max(0,1-abs(IDX-58))+(140)*max(0,1-abs(IDX-59))+(70)*max(0,1-abs(IDX-61))+(140)*max(0,1-abs(IDX-62))+(70)*max(0,1-abs(IDX-64))+(140)*max(0,1-abs(IDX-65))+(70)*max(0,1-abs(IDX-67))+(140)*max(0,1-abs(IDX-68))+(70)*max(0,1-abs(IDX-70))+(140)*max(0,1-abs(IDX-71))+(70)*max(0,1-abs(IDX-73))+(140)*max(0,1-abs(IDX-74))+(70)*max(0,1-abs(IDX-76))+(140)*max(0,1-abs(IDX-77))+(70)*max(0,1-abs(IDX-79))+(140)*max(0,1-abs(IDX-80))
ISFIT=1.16603251135e-10
NFIT=0.8043801630717
RSFIT=1.252429491587
C0FIT=5.896543968227
OMEGA=85199992.7653552
Port:PORT1 GEN 0 Num=1 Z=50 Ohm P[1]=polar(dbmtow(PinR),0) Freq[1]=13.56 MHz Noise=no
Short:PTX GEN TX Mode=0 SaveCurrent=yes
R:RTH TX TH R=(1/(OMEGA*CTH*1e-12*QCAP)) Noise=no
C:CTH TH 0 C=(CTH*1e-12)
R:RTS TX TS R=(1/(OMEGA*CTS*1e-12*QCAP)) Noise=no
C:CTS TS TXCOIL C=(CTS*1e-12)
L:L1 TXCOIL 0 L=2.49 uH R=(1.8*RWIND) Noise=no
L:L2 AC2 RXPLUS L=.330 uH R=(.399*RWIND) Noise=no
Mutual:LINK K=LinkK Inductor1="L1" Inductor2="L2"
Short:PRX RXPLUS RX Mode=0 SaveCurrent=yes
R:RRS RX RS R=(1/(OMEGA*CRS*1e-12*QCAP)) Noise=no
C:CRS RS AC1 C=(CRS*1e-12)
R:RRH AC1 RH R=(1/(OMEGA*CRH*1e-12*QCAP)) Noise=no
C:CRH RH AC2 C=(CRH*1e-12)
; Package pin 1 DC-, pins 2,3 AC, pin 4 DC+. No RF input pin is grounded.
Short:PACKAGE_I AC1 AC1A Mode=0 SaveCurrent=yes
L:lead2 AC1A P2 L=(LEADnH*1e-9) R=.008 Noise=no
L:lead3 AC2 P3 L=(LEADnH*1e-9) R=.008 Noise=no
L:lead4 P4 RAW L=(LEADnH*1e-9) R=.008 Noise=no
L:lead1 0 P1 L=(LEADnH*1e-9) R=.008 Noise=no
model BASFIT Diode Is=ISFIT N=NFIT Rs=RSFIT Cjo=(C0FIT*1e-12) Vj=.65 M=.5 Fc=.5 Tnom=25 Imax=100
Short:ID1 P1 A1 Mode=0 SaveCurrent=yes
Short:ID2 P2 A2 Mode=0 SaveCurrent=yes
Short:ID3 P1 A3 Mode=0 SaveCurrent=yes
Short:ID4 P3 A4 Mode=0 SaveCurrent=yes
"BASFIT":D1 A1 P2 Mode=1 Noise=no
"BASFIT":D2 A2 P4 Mode=1 Noise=no
"BASFIT":D3 A3 P3 Mode=1 Noise=no
"BASFIT":D4 A4 P4 Mode=1 Noise=no
; Assumed reservoir ESR/ESL; RF lead estimates and Q explain the sensitivity.
L:LRES RAW RR L=.7 nH R=.05 Noise=no
C:CRES RR 0 C=(CUF*1e-6)
Short:IDC RAW OUT Mode=0 SaveCurrent=yes
; Smooth compliance eliminates unphysical negative-voltage current demand.
; Above 2 V the current demand equals the named load to better than 5e-9 relative.
SDD:LOAD OUT 0 I[1,0]=(ILOADmA*1e-3*tanh(_v1/.2))
HB:HB1 MaxOrder=31 Freq[1]=13.56 MHz Order[1]=31 StatusLevel=0 OutputPlan="OUTP"
OutputPlan:OUTP Type="Output" UseNodeNestLevel=yes NodeNestLevel=1 UseCurrentNestLevel=yes CurrentNestLevel=1
SweepPlan:CASES Start=0 Stop=80 Step=1
ParamSweep:Batch SimInstanceName[1]="HB1" SweepVar="IDX" SweepPlan="CASES" StatusLevel=0
