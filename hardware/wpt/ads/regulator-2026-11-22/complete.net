;
;CuraLink rectifier reservoir emulator, TPS70950 load and line transitions
; Input ramps 0->6.5 V, sags to 5.2, rises to 12 V at light load, returns to 0.
; Conductance fixture is 24mA or 2mA at nominal 5V; finite load at startup.
V_Source:vrec src 0 V_Tran=pwl(time,0,0,0.0001,0,0.0003,6.5,0.004,6.5,0.00405,5.2,0.006,5.2,0.00605,6.5,0.008,6.5,0.0081,12,0.011,12,0.0115,0,0.02,0)
R:rsrc src rect_n R=0.2
C:cin rect_n 0 C=1u
V_Source:venable en 0 Vdc=2
; Static EN models the internally enabled hardware state. TI macro lacks pull-up.
V_Source:vload cmd 0 V_Tran=pwl(time,0,0,0.003,0,0.003002,1,0.007997,1,0.008,0,0.02,0)
SDD:gload wpt 0 cmd 0 I[1,0]=_v1*(0.0004+_v2*0.0044) I[2,0]=0
R:rcesr wpt cap R=0.02
C:cout cap 0 C=4.7u
tps70950:xreg rect_n 0 en wpt
