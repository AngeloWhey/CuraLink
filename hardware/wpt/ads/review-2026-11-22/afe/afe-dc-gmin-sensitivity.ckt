SDD:gvox com "vo+" vin com "vc+" com I[1,0]=(if(_v2>_v3) then (((_v2-_v3)*g)) else (0) endif) \
      I[2,0]=0 I[3,0]=0
SDD:gvo1 com "vo-" vin com "vc-" com I[1,0]=(if(_v2<_v3) then (((_v3-_v2)*g)) else (0) endif) \
      I[2,0]=0 I[3,0]=0
end tlv9002_clamp_amp_lo_0
