; AC_STIM=0 exactly reproduces source differential-AC fixture.
; AC_STIM=1 exactly reproduces source common-mode-AC fixture.
; DC ignores AC phasors and reproduces full-op fixture. 27 C, no noise analysis.
Options ResourceUsage=yes UseNutmegFormat=no EnableOptim=no TopDesignName="CuraLink:AFE_20261122:schematic" Temp=27 TopologyCheckMessages=yes Gmin=GMIN_LEVEL DcopOutputNodeVoltages=yes DcopOutputPinCurrents=yes
