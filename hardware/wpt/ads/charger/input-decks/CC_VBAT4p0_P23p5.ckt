; CuraLink isolated corrected floating full-bridge receiver, 2026-10-09
; Four ideal capacitors; full BAT54 model; authored static charger/control approximation.
; VPATH is a fixed voltage-drop fixture, not real SS14/TPS25200 behavior.
Options ResourceUsage=yes UseNutmegFormat=no EnableOptim=no TopDesignName="CuraLink:receiver_resistor_fixture:schematic" DcopOutputNodeVoltages=yes DcopOutputPinCurrents=yes
Pin_dBm=23.5
Rload=230
F0=13.56 MHz
Port:PORT1 Vin0 0 Num=1 Z=50 Ohm P[1]=polar(dbmtow(Pin_dBm),0) Freq[1]=F0 Noise=no
Short:TX_Probe Vin0 Vin Mode=0 SaveCurrent=yes
C:C5 Vin 0 C=374.739563788 pF
C:C3 Vin VinMatched C=59.3004634347 pF
L:L1 VinMatched 0 L=2.49 uH R=1.8 Noise=no
L:L2 IMPin Vout L=0.33 uH R=0.399 Noise=no
Mutual:Mutual1 K=0.0662 Inductor1="L1" Inductor2="L2"
C:C1 Vout VoutMatched C=826.205851833 pF
C:C6 VoutMatched IMPin C=773.593191905 pF
model DIODEM1 Diode Is=649e-9 N=1.04 Rs=2.09 Ikf=20e-3 Xti=2 Eg=0.58 Cjo=12.4e-12 M=0.381 Vj=0.391 Bv=50 Ibv=100e-6 Isr=431e-9 Nr=4.99 Nbv=1.04 Tnom=27 IkModel=1 Imax=1000 Trs1=0 Trs2=0
Short:D1_Probe 0 D1_A Mode=0 SaveCurrent=yes
"DIODEM1":DIODE1 D1_A VoutMatched Mode=1 Noise=no
Short:D2_Probe VoutMatched D2_A Mode=0 SaveCurrent=yes
"DIODEM1":DIODE2 D2_A DCout Mode=1 Noise=no
Short:D3_Probe 0 D3_A Mode=0 SaveCurrent=yes
"DIODEM1":DIODE3 D3_A IMPin Mode=1 Noise=no
Short:D4_Probe IMPin D4_A Mode=0 SaveCurrent=yes
"DIODEM1":DIODE4 D4_A DCout Mode=1 Noise=no
C:Cdc DCout 0 C=1 uF
Short:DC_Probe DCout LoadIn Mode=0 SaveCurrent=yes
VBAT=4
IPHASE=0.02
IQACTIVE=0.00075
IQSLEEP=0.00003
CHARGE_ALLOWED=1
VWAKE=max(3.0,VBAT+0.152)
VSTART=max(3.15,VBAT+0.188)
VDPM=max(3.6,VBAT+0.330)
WNUM=0.020
WDPM=0.15
ICTRL=0.0008
WOR=0.100
VPATH=0.28

R:RawFieldDivider LoadIn 0 R=110000 Noise=no
SDD:EfuseIQ LoadIn 0 I[1,0]=0.000143*max(0,min(1,_v1/2.5))
V_Source:FixedPathDrop LoadIn CHG_IN Vdc=VPATH
C:ChargerCin CHG_IN 0 C=2.2 uF
Short:Charger_Probe CHG_IN CHARGER_LOAD Mode=0 SaveCurrent=yes
SDD:Charger CHARGER_LOAD 0 I[1,0]=IQSLEEP*max(0,min(1,_v1/3.6))+(IQACTIVE-IQSLEEP)*max(0,min(1,(_v1-VWAKE)/WNUM))+CHARGE_ALLOWED*IPHASE*max(0,min(1,(_v1-VSTART)/WNUM))*max(0,min(1,(_v1-VDPM)/WDPM))
Short:Control_Probe CHG_IN CTRL_LOAD Mode=0 SaveCurrent=yes
SDD:Control CTRL_LOAD 0 I[1,0]=ICTRL*max(0,min(1,(_v1-VBAT)/WOR))
HB:HB1 MaxOrder=31 Freq[1]=F0 Order[1]=31 StatusLevel=0 OutputPlan="HB1_Output"
OutputPlan:HB1_Output Type="Output" UseNodeNestLevel=yes NodeNestLevel=2 UseEquationNestLevel=yes EquationNestLevel=2 UseSavedEquationNestLevel=yes SavedEquationNestLevel=2 UseDeviceCurrentNestLevel=yes DeviceCurrentNestLevel=2 DeviceCurrentDeviceType="All" DeviceCurrentSymSyntax=yes UseCurrentNestLevel=yes CurrentNestLevel=999 UseDeviceVoltageNestLevel=yes DeviceVoltageNestLevel=2 DeviceVoltageDeviceType="All"
