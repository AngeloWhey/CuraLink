*
.SUBCKT TLV9052_VCCS_LIM_CLAW+_0  VC+ VC- IOUT+ IOUT-
G1 IOUT+ IOUT- TABLE {ABS(V(VC+,VC-))} =
+(00, 2.00E-5)
+(02, 3.00E-5)
+(05, 9.00E-5)
+(10, 1.80E-4)
+(15, 2.80E-4)
+(20, 3.80E-4)
+(25, 5.00E-4)
+(30, 6.35E-4)
+(35, 8.00E-4)
+(40, 1.01E-3)
+(42, 1.12E-3)
+(45, 1.37E-3)
+(48, 2.00E-3)
.ENDS
*


.SUBCKT TLV9052_VCCS_LIM_CLAW-_0  VC+ VC- IOUT+ IOUT-
G1 IOUT+ IOUT- TABLE {ABS(V(VC+,VC-))} =
+(00, 2.00E-5)
+(02, 3.00E-5)
+(05, 7.50E-5)
+(10, 1.55E-4)
+(15, 2.35E-4)
+(20, 3.30E-4)
+(25, 4.30E-4)
+(30, 5.40E-4)
+(35, 6.75E-4)
+(40, 8.55E-4)
+(42, 9.50E-4)
+(45, 1.18E-3)
+(47, 1.53E-3)
+(48, 2.24E-3)
.ENDS
*


.SUBCKT TLV9052_VOS_DRIFT_0  VOS+ VOS-
.PARAM DC = 3.1261E-4
.PARAM POL = -1
.PARAM DRIFT = 0.5E-6
E1 VOS+ VOS- VALUE={DC+POL*DRIFT*(TEMP-27)}
.ENDS
*


.SUBCKT TLV9052_VCCS_LIM_2_0  VC+ VC- IOUT+ IOUT-
.PARAM GAIN = 3.969E-2
.PARAM IPOS = 2.8
.PARAM INEG = -2.8
G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}
.ENDS
*


.SUBCKT TLV9052_VOS_SRC_0  V+ V- REF+ REF-
E1 V+ 1 TABLE {(V(REF+, V-))} =
+(0, 0.0003)
+(1, 0.0003)
+(1.3, 0)
+(5.5, 0)
E2 1 V- TABLE {(V(V-, REF-))}=
+(-0.7, -2E-4)
+(-0.5, -2E-4)
+(-0.4, 0)
+(5.5, 0)
.ENDS TLV9052_VOS_SRC_0 
*


.SUBCKT TLV9052_VCCS_LIM_ZO_0  VC+ VC- IOUT+ IOUT-
.PARAM GAIN = 10
.PARAM IPOS = 45K
.PARAM INEG = -45K
G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}
.ENDS
*
.SUBCKT TLV9052_VNSE_0 1 2
* ngspice DC/AC/transient adapter: zero-mean noise port disabled
VZERO 1 2 DC 0
.ENDS TLV9052_VNSE_0
*
.SUBCKT TLV9052_FEMT_0 1 2
* ngspice DC/AC/transient adapter: zero-mean noise port disabled
IZERO 1 2 DC 0
.ENDS TLV9052_FEMT_0
*


.SUBCKT TLV9052_VCCS_LIM_1_0  VC+ VC- IOUT+ IOUT-
.PARAM GAIN = 1E-4
.PARAM IPOS = .5
.PARAM INEG = -.5
G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}
.ENDS
*


.SUBCKT TLV9052_VCCS_LIMIT_IQ_0  VC+ VC- IOUT+ IOUT-
.PARAM GAIN = 1E-3
G1 IOUT- IOUT+ VALUE={IF( (V(VC+,VC-)<=0),0,GAIN*V(VC+,VC-) )}
.ENDS
*


.SUBCKT TLV9052_CLAMP_AMP_LO_0  VC+ VC- VIN COM VO+ VO-
.PARAM G=1
GVO+ COM VO+ VALUE = {IF(V(VIN,COM)>V(VC+,COM),((V(VIN,COM)-V(VC+,COM))*G),0)}
GVO- COM VO- VALUE = {IF(V(VIN,COM)<V(VC-,COM),((V(VC-,COM)-V(VIN,COM))*G),0)}
.ENDS
*


.SUBCKT TLV9052_CLAMP_AMP_HI_0  VC+ VC- VIN COM VO+ VO-
.PARAM G=10
GVO+ COM VO+ VALUE = {IF(V(VIN,COM)>V(VC+,COM),((V(VIN,COM)-V(VC+,COM))*G),0)}
GVO- COM VO- VALUE = {IF(V(VIN,COM)<V(VC-,COM),((V(VC-,COM)-V(VIN,COM))*G),0)}
.ENDS
*


.SUBCKT TLV9052_VCCS_LIM_GR_0  VC+ VC- IOUT+ IOUT-
.PARAM GAIN = 1
.PARAM IPOS = 4
.PARAM INEG = -4
G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}
.ENDS
*


.SUBCKT TLV9052_VCCS_LIM_4_0  VC+ VC- IOUT+ IOUT-
.PARAM GAIN = 1
.PARAM IPOS = 1.8
.PARAM INEG = -1.8
G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}
.ENDS
*


.SUBCKT TLV9052_VCCS_LIM_3_0  VC+ VC- IOUT+ IOUT-
.PARAM GAIN = 1
.PARAM IPOS = 740E-3
.PARAM INEG = -740E-3
G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}
.ENDS
*


.SUBCKT TLV9052_OL_SENSE_0  COM SW+ OLN  OLP
GSW+ COM SW+ VALUE = {IF((V(OLN,COM)>10E-3 | V(OLP,COM)>10E-3),1,0)}
.ENDS
*


.SUBCKT TLV9052_VCCS_EXT_LIM_0  VIN+ VIN- IOUT- IOUT+ VP+ VP-
.PARAM GAIN = 1
G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VIN+,VIN-),V(VP-,VIN-), V(VP+,VIN-))}
.ENDS
*


