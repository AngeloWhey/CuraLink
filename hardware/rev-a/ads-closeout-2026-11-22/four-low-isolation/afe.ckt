 _efunc_3(x)=pwl(x,00.0000,0.00001,14.0000,0.000379,28.0000,0.000877,37.3333,0.001382,37.8000,0.00142,38.7333,0.001493,39.6667,0.001583,40.6000,0.001703,41.5333,0.00191,42.0000,0.00204)
