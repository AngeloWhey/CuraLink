SDD:e2 _node1 "v-" "v-" "ref-" F[1,0]=_efunc_2(((_v2)))-_v1 I[2,0]=0
 _efunc_2(x)=pwl(x,-0.7,-2e-4,-0.5,-2e-4,-0.4,0,5.5,0)
end tlv9002_vos_src_0
